{
  "name": "dsh-tide-gauge",
  "version": "0.1.0",
  "description": "TideGauge 潮汐计 — a personal usage & billing gauge for the DeepSeek Harness web surface",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "billing",
    "balance",
    "token",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DzDenzel/dsh-tide-gauge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
